{
  "name": "recruitment-server",
  "version": "1.0.0",
  "description": "Backend API for recruitment system with Prisma ORM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --no-engine && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --no-engine",
    "db:push": "prisma db push --skip-generate",
    "migrate": "prisma db push --skip-generate",
    "prisma:studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "keywords": [],
